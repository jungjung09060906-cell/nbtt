                    value={params.topP}
                    onChange={(e) => setParams({ ...params, topP: parseFloat(e.target.value) })}
                    className="w-full accent-zinc-200 bg-zinc-800 rounded h-1.5 cursor-pointer"
                  />
                </div>

                <div>
                  <div className="flex justify-between text-xs font-medium text-zinc-300 mb-1 font-mono">
                    <span>Top K: {params.topK}</span>
                  </div>
                  <input 
                    type="range" min="1" max="100" step="1"
                    value={params.topK}
                    onChange={(e) => setParams({ ...params, topK: parseInt(e.target.value) })}
                    className="w-full accent-zinc-200 bg-zinc-800 rounded h-1.5 cursor-pointer"
                  />
                </div>

                <div>
                  <div className="flex justify-between text-xs font-medium text-zinc-300 mb-1 font-mono">
                    <span>반복 감점 (Repetition Penalty): {params.repetitionPenalty}</span>
                  </div>
                  <input 
                    type="range" min="1.0" max="2.0" step="0.05"
                    value={params.repetitionPenalty}
                    onChange={(e) => setParams({ ...params, repetitionPenalty: parseFloat(e.target.value) })}
                    className="w-full accent-zinc-200 bg-zinc-800 rounded h-1.5 cursor-pointer"
                  />
                </div>
              </div>

              <div className="pt-4 border-t border-zinc-800">
                <label className="block text-xs font-semibold text-zinc-300 mb-2">시스템 프롬프트 템플릿</label>
                <textarea 
                  rows={7}
                  value={params.systemPromptTemplate}
                  onChange={(e) => setParams({ ...params, systemPromptTemplate: e.target.value })}
                  className="w-full bg-zinc-950 border border-zinc-800 rounded p-3 text-xs font-mono text-zinc-300 focus:border-zinc-600 outline-none leading-relaxed"
                />
              </div>
            </div>
          </div>
        )}

        {/* TAB 5: API & Flash Models Selector */}
        {activeTab === 'api' && (
          <div className="flex-1 overflow-y-auto p-6 md:p-10 max-w-3xl mx-auto w-full">
            <div className="border-b border-zinc-800 pb-4 mb-8">
              <h1 className="text-xl font-bold text-zinc-100 flex items-center gap-2">
                <Cpu size={20} />
                API 및 Gemini Flash 모델 선택
              </h1>
              <p className="text-xs text-zinc-500 mt-1">원하시는 Flash 모델과 API 키를 설정합니다.</p>
            </div>

            <div className="bg-zinc-900 rounded border border-zinc-800 p-6 space-y-6">
              <div>
                <label className="block text-xs font-semibold text-zinc-400 mb-2">Gemini Flash 모델 (Pro 옵션 제외됨)</label>
                <div className="relative">
                  <select
                    value={apiConfig.model}
                    onChange={(e) => setApiConfig({ ...apiConfig, model: e.target.value })}
                    className="w-full bg-zinc-950 border border-zinc-800 rounded px-3 py-2.5 text-xs text-zinc-100 focus:border-zinc-600 outline-none font-mono appearance-none"
                  >
                    {GEMINI_FLASH_MODELS.map(m => (
                      <option key={m.id} value={m.id}>{m.name}</option>
                    ))}
                  </select>
                  <ChevronDown size={14} className="absolute right-3 top-3.5 text-zinc-500 pointer-events-none" />
                </div>
              </div>

              <div>
                <label className="block text-xs font-semibold text-zinc-400 mb-1">Google Gemini API Key</label>
                <div className="relative">
                  <input 
                    type="password"
                    value={apiConfig.apiKey}
                    onChange={(e) => setApiConfig({ ...apiConfig, apiKey: e.target.value })}
                    placeholder="AIzaSy..."
                    className="w-full bg-zinc-950 border border-zinc-800 rounded px-3 py-2.5 text-xs text-zinc-100 focus:border-zinc-600 outline-none font-mono"
                  />
                  <Key size={14} className="absolute right-3 top-3 text-zinc-500" />
                </div>
                <p className="text-[11px] text-zinc-500 mt-1">입력된 키는 사용자 브라우저(LocalStorage)에만 안전하게 보관됩니다.</p>
              </div>

              <div className="p-4 rounded bg-zinc-950 border border-zinc-800 text-xs text-zinc-400 space-y-2">
                <div className="flex items-center gap-2 font-semibold text-zinc-200">
                  <Shield size={14} className="text-zinc-400" />
                  API 키 없이도 이용 가능
                </div>
                <p>API 키가 비어있으면 시스템 자체 시뮬레이션 엔진이 작동하여 문제없이 작동 여부를 테스트해 볼 수 있습니다.</p>
              </div>
            </div>
          </div>
        )}

      </div>
    </div>
  );
}
