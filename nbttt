import React, { useState, useEffect, useRef } from 'react';
import { 
  MessageSquare, User, Bot, Sliders, Cpu, Plus, Trash2, 
  Download, Upload, RefreshCw, Send, ChevronRight, ChevronLeft,
  Key, Shield, HelpCircle, Edit3, FileText, ChevronDown, Check, AlertCircle
} from 'lucide-react';

// Gemini Flash Model Lineup Only (No Pro models)
