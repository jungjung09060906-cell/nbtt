const DEFAULT_PERSONA = {
  name: '방랑자',
  description: '세계를 유랑하며 수많은 인물과 만나는 여행자.',
  avatar: 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=150&auto=format&fit=crop&q=80'
};

const DEFAULT_PARAMS = {
  temperature: 0.8,
  topP: 0.9,
  topK: 40,
  maxOutputTokens: 32000, // Explicitly set to 32,000
  repetitionPenalty: 1.1,
  systemPromptTemplate: `You are playing the role of {{char}}. Stay in character at all times. Always respond in Korean naturally.
Character Details:
Name: {{char}}
Description: {{description}}
Personality: {{personality}}
Scenario: {{scenario}}

User Persona:
Name: {{user}}
Description: {{user_description}}

Guidelines:
- Respond in Korean using descriptive actions like *action* and dialogue in quotes.
- Keep the dialogue consistent with {{char}}'s personality.`
};

export default function App() {
  const [activeTab, setActiveTab] = useState('chat'); // 'chat' | 'characters' | 'persona' | 'params' | 'api'

  // Persistent Characters
  const [characters, setCharacters] = useState(() => {
    try {
      const saved = localStorage.getItem('risu_mono_v3_characters');
      return saved ? JSON.parse(saved) : DEFAULT_CHARACTERS;
    } catch (e) {
      return DEFAULT_CHARACTERS;
    }
  });

  const [selectedCharId, setSelectedCharId] = useState(() => characters[0]?.id || 'char_01');

  // Persistent Persona
  const [persona, setPersona] = useState(() => {
    try {
      const saved = localStorage.getItem('risu_mono_v3_persona');
      return saved ? JSON.parse(saved) : DEFAULT_PERSONA;
    } catch (e) {
      return DEFAULT_PERSONA;
    }
  });

  // Persistent Parameters (Max output token = 32000)
  const [params, setParams] = useState(() => {
    try {
      const saved = localStorage.getItem('risu_mono_v3_params');
      if (saved) {
        const parsed = JSON.parse(saved);
        return { ...parsed, maxOutputTokens: 32000 };
      }
    } catch (e) {}
    return DEFAULT_PARAMS;
  });

  // Persistent API Config (Gemini Flash default)
  const [apiConfig, setApiConfig] = useState(() => {
    try {
      const saved = localStorage.getItem('risu_mono_v3_apiconfig');
      if (saved) {
        const parsed = JSON.parse(saved);
        // Force replace any leftover pro models with flash
        if (parsed.model && parsed.model.includes('pro')) {
          parsed.model = 'gemini-3.8-flash';
        }
        return parsed;
      }
    } catch (e) {}
    return { provider: 'gemini', apiKey: '', model: 'gemini-3.8-flash' };
  });

  // Persistent Chats
  const [chats, setChats] = useState(() => {
    try {
      const saved = localStorage.getItem('risu_mono_v3_chats');
      if (saved) return JSON.parse(saved);
    } catch (e) {}
    const initial = {};
    DEFAULT_CHARACTERS.forEach(c => {
      initial[c.id] = [{ id: '1', sender: 'char', text: c.firstMessage, timestamp: new Date().toISOString() }];
    });
    return initial;
  });

  const [inputMessage, setInputMessage] = useState('');
  const [isGenerating, setIsGenerating] = useState(false);
  const [showRightSidebar, setShowRightSidebar] = useState(true);
  const [editingChar, setEditingChar] = useState(null);
  const [editingMsgId, setEditingMsgId] = useState(null);
  const [editingMsgText, setEditingMsgText] = useState('');
  const [apiErrorStatus, setApiErrorStatus] = useState(null);
  const chatEndRef = useRef(null);

  const activeChar = characters.find(c => c.id === selectedCharId) || characters[0];
  const activeMessages = chats[selectedCharId] || [];

  useEffect(() => {
    localStorage.setItem('risu_mono_v3_characters', JSON.stringify(characters));
  }, [characters]);

  useEffect(() => {
    localStorage.setItem('risu_mono_v3_persona', JSON.stringify(persona));
  }, [persona]);

  useEffect(() => {
    localStorage.setItem('risu_mono_v3_params', JSON.stringify(params));
  }, [params]);

  useEffect(() => {
    localStorage.setItem('risu_mono_v3_apiconfig', JSON.stringify(apiConfig));
  }, [apiConfig]);

  useEffect(() => {
    localStorage.setItem('risu_mono_v3_chats', JSON.stringify(chats));
  }, [chats]);

  useEffect(() => {
    chatEndRef.current?.scrollIntoView({ behavior: 'smooth' });
  }, [activeMessages, isGenerating]);

  const handleSaveCharacter = (charData) => {
    if (charData.id) {
      setCharacters(prev => prev.map(c => c.id === charData.id ? charData : c));
    } else {
      const newChar = { ...charData, id: 'char_' + Date.now() };
      setCharacters(prev => [...prev, newChar]);
      setChats(prev => ({
        ...prev,
        [newChar.id]: [{ id: '1', sender: 'char', text: newChar.firstMessage || '안녕하세요.', timestamp: new Date().toISOString() }]
      }));
      setSelectedCharId(newChar.id);
    }
    setEditingChar(null);
  };

  const handleDeleteCharacter = (id) => {
    if (characters.length <= 1) return;
    setCharacters(prev => prev.filter(c => c.id !== id));
    if (selectedCharId === id) {
      const remaining = characters.filter(c => c.id !== id);
      setSelectedCharId(remaining[0].id);
    }
  };

  const handleResetChat = () => {
    if (!activeChar) return;
    setChats(prev => ({
      ...prev,
      [selectedCharId]: [{ id: Date.now().toString(), sender: 'char', text: activeChar.firstMessage, timestamp: new Date().toISOString() }]
    }));
    setApiErrorStatus(null);
  };

  const handleDeleteMessage = (msgId) => {
    setChats(prev => ({
      ...prev,
      [selectedCharId]: prev[selectedCharId].filter(m => m.id !== msgId)
    }));
  };

  const handleStartEditMessage = (msg) => {
    setEditingMsgId(msg.id);
    setEditingMsgText(msg.text);
  };

  const handleSaveEditedMessage = () => {
    if (!editingMsgId) return;
    setChats(prev => ({
      ...prev,
      [selectedCharId]: prev[selectedCharId].map(m => m.id === editingMsgId ? { ...m, text: editingMsgText } : m)
    }));
    setEditingMsgId(null);
    setEditingMsgText('');
  };

  /**
   * CRITICAL FIX FOR API TURN ERROR ("Requests ending with a model turn are not supported")
   * This function formats messages so Google Gemini API ALWAYS receives strictly alternating
   * user -> model -> user -> model sequence, ending with a user turn.
   */
  const prepareGeminiContents = (rawMessages) => {
    if (!rawMessages || rawMessages.length === 0) return [];

    const contents = [];
    
    // Iterate over raw messages and alternate strictly
    for (let i = 0; i < rawMessages.length; i++) {
      const msg = rawMessages[i];
      const targetRole = msg.sender === 'user' ? 'user' : 'model';

      if (contents.length === 0) {
        // First message MUST be a user turn. If first message is character intro, merge it or convert to user context
        if (targetRole === 'model') {
          contents.push({
            role: 'user',
            parts: [{ text: `[캐릭터 첫 인사 상황]\n${msg.text}` }]
          });
        } else {
          contents.push({
            role: 'user',
            parts: [{ text: msg.text }]
          });
        }
      } else {
        const lastRole = contents[contents.length - 1].role;

        if (lastRole === targetRole) {
          // Merge consecutive messages from same role to avoid API turn sequence errors
          contents[contents.length - 1].parts[0].text += `\n\n${msg.text}`;
        } else {
          contents.push({
            role: targetRole,
            parts: [{ text: msg.text }]
          });
        }
      }
    }

    // Ensure payload strictly ends with a 'user' turn before model generation
    if (contents.length > 0 && contents[contents.length - 1].role === 'model') {
      contents.push({
        role: 'user',
        parts: [{ text: '계속 이야기를 진행해 주세요.' }]
      });
    }

    return contents;
  };

  const handleSendMessage = async (customUserText = null) => {
    const textToSend = customUserText !== null ? customUserText : inputMessage.trim();
    if (!textToSend || isGenerating || !activeChar) return;

    setApiErrorStatus(null);

    let updatedMessages = [...activeMessages];
    if (customUserText === null) {
      const userMsg = {
        id: Date.now().toString(),
        sender: 'user',
        text: textToSend,
        timestamp: new Date().toISOString()
      };
      updatedMessages.push(userMsg);
      setInputMessage('');
    }

    setChats(prev => ({ ...prev, [selectedCharId]: updatedMessages }));
    setIsGenerating(true);

    try {
      const systemPrompt = params.systemPromptTemplate
        .replace(/{{char}}/g, activeChar.name)
        .replace(/{{description}}/g, activeChar.description || '')
        .replace(/{{personality}}/g, activeChar.personality || '')
        .replace(/{{scenario}}/g, activeChar.scenario || '')
        .replace(/{{user}}/g, persona.name || '유저')
        .replace(/{{user_description}}/g, persona.description || '');

      let botReplyText = '';

      if (apiConfig.apiKey.trim().length > 0) {
        // Sanitize turn history for Gemini API
        const formattedContents = prepareGeminiContents(updatedMessages);

        const currentModel = apiConfig.model || 'gemini-3.8-flash';
        const endpoint = `https://generativelanguage.googleapis.com/v1beta/models/${currentModel}:generateContent?key=${apiConfig.apiKey.trim()}`;

        const payload = {
          contents: formattedContents,
          systemInstruction: { parts: [{ text: systemPrompt }] },
          generationConfig: {
            temperature: parseFloat(params.temperature),
            topP: parseFloat(params.topP),
            topK: parseInt(params.topK),
            maxOutputTokens: parseInt(params.maxOutputTokens) || 32000
          }
        };

        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await response.json();

        if (data.candidates && data.candidates[0]?.content?.parts?.[0]?.text) {
          botReplyText = data.candidates[0].content.parts[0].text;
        } else if (data.error) {
          throw new Error(data.error.message || 'API 응답 오류가 발생했습니다.');
        } else {
          throw new Error('올바른 답변을 생성하지 못했습니다.');
        }
      } else {
        // Fallback Local Simulation Engine (Mock Mode)
        await new Promise(r => setTimeout(r, 800));
        botReplyText = `*(${activeChar.name}이(가) ${persona.name}의 질문에 조용히 고개를 끄덕인다.)*\n\n"최대 출력 토큰 제한인 ${params.maxOutputTokens.toLocaleString()} 토큰 내에서 정상적으로 메시지를 처리하고 있습니다.\n\n*(참고: [API / 모델 설정] 탭에 Gemini API 키를 넣으시면 ${apiConfig.model} 모델이 실시간 응답합니다.)*\n\n'${textToSend}' 에 대한 이야기를 계속 이어가볼까요?"`;
      }

      const botMsg = {
        id: (Date.now() + 1).toString(),
        sender: 'char',
        text: botReplyText,
        timestamp: new Date().toISOString()
      };

      setChats(prev => ({
        ...prev,
        [selectedCharId]: [...updatedMessages, botMsg]
      }));

    } catch (err) {
      console.error(err);
      setApiErrorStatus(err.message || 'API 호출에 실패했습니다.');

      const errorMsg = {
        id: (Date.now() + 1).toString(),
        sender: 'char',
        text: `*(오류 발생: ${err.message})*\n\nAPI 키, 인터넷 연결 또는 선택하신 모델 (${apiConfig.model}) 설정을 확인해 주세요.`,
        timestamp: new Date().toISOString()
      };
      
      setChats(prev => ({
        ...prev,
        [selectedCharId]: [...updatedMessages, errorMsg]
      }));
    } finally {
      setIsGenerating(false);
    }
  };

  const handleRegenerate = () => {
    if (activeMessages.length < 2 || isGenerating) return;
    const lastUserIdx = activeMessages.map(m => m.sender).lastIndexOf('user');
    if (lastUserIdx !== -1) {
      const truncated = activeMessages.slice(0, lastUserIdx + 1);
      const lastUserMsg = truncated[truncated.length - 1].text;
      setChats(prev => ({ ...prev, [selectedCharId]: truncated }));
      handleSendMessage(lastUserMsg);
    }
  };

  const handleExportCharacter = (char) => {
    const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(char, null, 2));
    const downloadAnchor = document.createElement('a');
    downloadAnchor.setAttribute("href", dataStr);
    downloadAnchor.setAttribute("download", `${char.name.toLowerCase().replace(/\s+/g, '_')}_card.json`);
    document.body.appendChild(downloadAnchor);
    downloadAnchor.click();
    downloadAnchor.remove();
  };

  const handleImportCharacter = (e) => {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (event) => {
      try {
        const imported = JSON.parse(event.target.result);
        if (imported.name) {
          handleSaveCharacter({
            ...imported,
            id: 'char_' + Date.now()
          });
        }
      } catch (err) {
        alert('올바른 캐릭터 JSON 파일이 아닙니다.');
      }
    };
    reader.readAsText(file);
  };

  return (
    <div className="flex h-screen w-screen bg-zinc-950 text-zinc-100 font-sans overflow-hidden select-none">
      
      {/* Navigation Bar */}
      <nav className="w-16 md:w-20 bg-zinc-900 border-r border-zinc-800 flex flex-col items-center py-4 justify-between z-20 shrink-0">
        <div className="flex flex-col items-center gap-6 w-full">
          <div className="w-10 h-10 rounded bg-zinc-100 text-zinc-950 flex items-center justify-center font-black text-lg tracking-widest shadow-sm">
            R
          </div>

          <div className="w-8 h-[1px] bg-zinc-800 my-1" />

          <button 
            onClick={() => setActiveTab('chat')}
            className={`p-3 rounded transition-colors relative group ${activeTab === 'chat' ? 'bg-zinc-800 text-zinc-100 border border-zinc-700' : 'text-zinc-500 hover:text-zinc-300 hover:bg-zinc-800/40'}`}
            title="대화창"
          >
            <MessageSquare size={20} />
            <span className="absolute left-full ml-3 px-2 py-1 bg-zinc-900 text-xs text-zinc-200 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none border border-zinc-800 z-50">
              대화창
            </span>
          </button>

          <button 
            onClick={() => setActiveTab('characters')}
            className={`p-3 rounded transition-colors relative group ${activeTab === 'characters' ? 'bg-zinc-800 text-zinc-100 border border-zinc-700' : 'text-zinc-500 hover:text-zinc-300 hover:bg-zinc-800/40'}`}
            title="캐릭터 관리"
          >
            <Bot size={20} />
            <span className="absolute left-full ml-3 px-2 py-1 bg-zinc-900 text-xs text-zinc-200 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none border border-zinc-800 z-50">
              캐릭터 관리 ({characters.length})
            </span>
          </button>

          <button 
            onClick={() => setActiveTab('persona')}
            className={`p-3 rounded transition-colors relative group ${activeTab === 'persona' ? 'bg-zinc-800 text-zinc-100 border border-zinc-700' : 'text-zinc-500 hover:text-zinc-300 hover:bg-zinc-800/40'}`}
            title="유저 페르소나"
          >
            <User size={20} />
            <span className="absolute left-full ml-3 px-2 py-1 bg-zinc-900 text-xs text-zinc-200 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none border border-zinc-800 z-50">
              유저 페르소나
            </span>
          </button>

          <button 
            onClick={() => setActiveTab('params')}
            className={`p-3 rounded transition-colors relative group ${activeTab === 'params' ? 'bg-zinc-800 text-zinc-100 border border-zinc-700' : 'text-zinc-500 hover:text-zinc-300 hover:bg-zinc-800/40'}`}
            title="파라미터 설정"
          >
            <Sliders size={20} />
            <span className="absolute left-full ml-3 px-2 py-1 bg-zinc-900 text-xs text-zinc-200 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none border border-zinc-800 z-50">
              파라미터 설정 (32,000 토큰)
            </span>
          </button>

          <button 
            onClick={() => setActiveTab('api')}
            className={`p-3 rounded transition-colors relative group ${activeTab === 'api' ? 'bg-zinc-800 text-zinc-100 border border-zinc-700' : 'text-zinc-500 hover:text-zinc-300 hover:bg-zinc-800/40'}`}
            title="API / 모델 설정"
          >
            <Cpu size={20} />
            <span className="absolute left-full ml-3 px-2 py-1 bg-zinc-900 text-xs text-zinc-200 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none border border-zinc-800 z-50">
              API / 모델 설정
            </span>
          </button>
        </div>

        <div className="flex flex-col items-center gap-2">
          <div className="w-2 h-2 rounded-full bg-zinc-400" title="시스템 준비됨" />
        </div>
      </nav>

      {/* Main Container */}
      <div className="flex-1 flex overflow-hidden relative bg-zinc-950">

        {/* TAB 1: Chat View */}
        {activeTab === 'chat' && (
          <div className="flex-1 flex flex-col h-full relative overflow-hidden">
            
            {/* Header */}
            <div className="h-16 border-b border-zinc-800 bg-zinc-900/90 px-6 flex items-center justify-between z-10">
              <div className="flex items-center gap-4">
                <img 
                  src={activeChar?.avatar} 
                  alt={activeChar?.name} 
                  className="w-10 h-10 rounded object-cover border border-zinc-800"
                />
                <div>
                  <h2 className="font-bold text-zinc-100 flex items-center gap-2 text-sm">
                    {activeChar?.name}
                    <span className="text-[10px] font-mono text-zinc-400 bg-zinc-800 border border-zinc-700 px-2 py-0.5 rounded">
                      {apiConfig.model}
                    </span>
                  </h2>
                  <p className="text-xs text-zinc-500 truncate max-w-xs md:max-w-md">
                    {activeChar?.title || activeChar?.description}
                  </p>
                </div>
              </div>

              <div className="flex items-center gap-3">
                <button 
                  onClick={handleResetChat}
                  className="px-3 py-1.5 rounded text-xs font-medium bg-zinc-800 hover:bg-zinc-700 text-zinc-300 transition-colors flex items-center gap-1.5 border border-zinc-700"
                  title="대화 초기화"
                >
                  <RefreshCw size={14} />
                  초기화
                </button>
                <button 
                  onClick={() => setShowRightSidebar(!showRightSidebar)}
                  className="p-2 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800 transition-colors"
                >
